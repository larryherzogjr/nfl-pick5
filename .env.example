# Flask session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-random-string

# PostgreSQL connection URL — points at the `db` service inside Docker; change for non-compose hosts
DATABASE_URL=postgresql://pick5:pick5@db:5432/pick5

# Google OAuth 2.0 client ID from Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI to register in Google Console:
#   dev:  http://localhost:5000/auth/callback/google
#   prod: https://<your-domain>/auth/callback/google
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 client secret paired with GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=

# Meta (Facebook) OAuth app ID from developers.facebook.com
META_APP_ID=

# Meta (Facebook) OAuth app secret paired with META_APP_ID
META_APP_SECRET=

# The Odds API key from https://the-odds-api.com (free tier: 500 requests/month)
ODDS_API_KEY=

# Sportsbook key to prefer when multiple bookmakers report a spread (e.g., fanduel, draftkings)
ODDS_PREFERRED_BOOK=fanduel

# Base URL the React frontend uses to call the backend API
VITE_API_BASE_URL=http://localhost:5000

# Public URL of the React frontend — backend redirects here after successful OAuth callback
FRONTEND_URL=http://localhost:3000

# Set to "true" in production (HTTPS) so the session cookie is only sent over TLS
SESSION_COOKIE_SECURE=false
